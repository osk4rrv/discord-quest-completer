#include <windows.h>
1 RT_MANIFEST "app.manifest"
101 RCDATA "../assets/fonts/Inter.ttf"
102 RCDATA "../assets/fonts/fa-solid-900.ttf"
104 RCDATA "../assets/fonts/fa-brands-400.ttf"
105 RCDATA "../assets/quest.ico"
106 RCDATA "../assets/metadata/quest-paths.json"
201 RCDATA "../assets/licenses/Inter-OFL.txt"
202 RCDATA "../assets/licenses/FontAwesome-LICENSE.txt"
203 RCDATA "../assets/licenses/JSON-MIT.txt"
103 ICON "../assets/quest.ico"

1 VERSIONINFO
FILEVERSION 4,6,1,0
PRODUCTVERSION 4,6,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Quest Completer"
            VALUE "FileVersion", "4.6.1"
            VALUE "ProductName", "Quest Completer"
            VALUE "ProductVersion", "4.6.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
